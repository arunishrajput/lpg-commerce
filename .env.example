# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/lpg_commerce"

# --- Auth ---------------------------------------------------------------
# Random 32+ byte secret used to sign/derive session material.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Payments (abstraction layer — see src/services/payments) -------------
# "mock" works out of the box for local development.
PAYMENT_PROVIDER="mock"
PAYMENT_KEY=""
PAYMENT_SECRET=""

# --- AI assistant (see src/features/ai) ------------------------------------
AI_PROVIDER="anthropic"
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# --- Location / maps (see src/services/location) ---------------------------
MAPS_PROVIDER="mock"
MAPS_API_KEY=""

# --- Email (see src/services/email) -----------------------------------------
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""

# --- Object storage (see src/services/storage) ------------------------------
STORAGE_PROVIDER="mock"
STORAGE_BUCKET=""
